# Copier en `.env` (dans server/) pour le développement local hors Docker.
# Toutes les variables sont préfixées par DR_ ; voir app/config.py pour les valeurs par défaut.

DR_ENV=dev
DR_DATABASE_URL=postgresql+asyncpg://refuge:refuge@localhost:5432/refuge
DR_REDIS_URL=redis://localhost:6379/0

# Au moins 32 caractères. À remplacer en production : python -c "import secrets; print(secrets.token_urlsafe(48))"
DR_JWT_SECRET=dev-secret-a-changer-en-production-0123456789
DR_JWT_TTL_MINUTES=1440
DR_ZONE_TICKET_TTL_SECONDS=30

DR_TICK_RATE=20
DR_MAX_CHARACTERS_PER_ACCOUNT=1
# Liste JSON des origines autorisées (client Vite en développement).
DR_CORS_ORIGINS=["http://localhost:5173"]

# Tests uniquement : base Postgres JETABLE (schéma supprimé à chaque test). Absent → SQLite temporaire.
# DR_TEST_DATABASE_URL=postgresql+asyncpg://refuge:refuge@localhost:5432/refuge_test
